  36    { name: "Corner Cafe", address: "Laitumkhrah, Shillong", neighborhood: "Laitumkhrah", vibeTags: ["Corner Spot", "Local Hangout", "Coffee", "Snacks", "Casual"], theme: "Classic Neighborhood Corner Cafe", tagline: "Everyone's Corner, Everyone's Cafe", introduction: "Exactly what its name promises — a warm, no-fuss corner cafe in the heart of Laitumkhrah where regulars linger over coffee and snacks. Corner Cafe is the purest expression of Shillong's neighborhood cafe culture: unpretentious, reliable, and always welcoming.", whyVisit: "For an authentic neighborhood cafe experience — good coffee, simple food, and friendly locals.", mustTry: [{ name: "Cappuccino", description: "Double shot espresso, steamed milk, thick velvety foam.", price: "₹130" }, { name: "Veg Wrap", description: "Whole wheat tortilla, mixed vegetables, cheese, house sauce.", price: "₹110" }] },
