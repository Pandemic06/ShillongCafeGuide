  38    { name: "The Press Cafe", address: "OB Shopping Mall, Police Bazar, Shillong", neighborhood: "Police Bazaar", vibeTags: ["Artisan Coffee", "Local Beans", "Irish Coffee", "Desserts", "Cozy"], theme: "Journalist's Den & Artisan Coffee Parlour", tagline: "Stop the Press — This Coffee Is Too Good", introduction: "The Press Cafe in OB Shopping Mall is Police Bazaar's finest artisan coffee destination, sourcing and roasting locally grown blends from Meghalaya's hills. The Irish Coffee is legendary, and the housemade desserts draw a devoted daily crowd.", whyVisit: "For Shillong's best Irish coffee and locally sourced artisan coffee blends in a warm, bookish atmosphere.", mustTry: [{ name: "Irish Coffee", description: "Hot strong coffee, Irish whiskey, lightly whipped cream float.", price: "₹200" }, { name: "Locally Sourced Cold Brew", description: "Meghalaya hill beans, 18-hour cold brew, served over ice.", price: "₹180" }] },
  39:   { name: "Open Up Cafe", address: "Mawroh, Mawlai, Shillong", neighborhood: "Mawlai", vibeTags: ["Vibrant", "Games", "Diverse Menu", "Youth Crowd", "Mawlai"], theme: "Colorful Youth Hangout with Board Games & Food", tagline: "Open Up, Hang Out, Come Back Tomorrow", introduction: "Open Up Cafe in Mawlai's Mawroh neighborhood is the area's most beloved youth hangout, combining vibrant comic-character interiors (think Batman murals), a surprisingly diverse menu, and shelves of board games. Hotdogs, momos, and burgers rule the menu.", whyVisit: "For the most fun and energetic cafe atmosphere in Shillong's Mawlai area, complete with games and great hotdogs.", mustTry: [{ name: "Spicy Hotdog", description: "Grilled pork hotdog, spicy tangy dip, mustard, caramelized onions.", price: "₹110" }, { name: "Steamed Veg Momos", description: "Fresh vegetable dumplings, steamed, served with spicy red chilli sauce.", price: "₹90" }] },
